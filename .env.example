# Copie ce fichier en .env et renseigne ta clé API Claude.
# Récupère une clé sur https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle Claude utilisé pour l'analyse des moments forts.
# Par défaut : claude-opus-4-8 (le plus intelligent).
# Alternative plus économique : claude-sonnet-4-6
# CLIPPER_MODEL=claude-opus-4-8

# Optionnel : taille du modèle Whisper (tiny, base, small, medium, large-v3).
# Plus grand = plus précis mais plus lent. Par défaut : large-v3
# CLIPPER_WHISPER_MODEL=large-v3

# Optionnel : device pour Whisper (cpu, cuda). Par défaut : auto-détection.
# CLIPPER_WHISPER_DEVICE=cuda
